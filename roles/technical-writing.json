{
  "marketplace": "tokenmaxxxer-technical-writing",
  "repo": "tokenmaxxxer/technical-writing-rulebook",
  "path": "$TOKENMAXXXER_RULEBOOKS/technical-writing-rulebook",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "github.com"
      ]
    }
  },
  "decides": "독자가 알아야 할 것을 어떻게 구조화할지",
  "use_when": "외부 공개 문서가 필요할 때",
  "produces": "doc outline, draft, target-reader note",
  "write_scope": [
    "docs/issue-<n>/reports/technical-writing.md"
  ],
  "record_fields": {
    "loop_state": {
      "progress": [
        "drafting",
        "reviewing"
      ],
      "terminal": [
        "landed"
      ],
      "refusal": [
        "quadrant-undeclared"
      ],
      "error": [
        "doc-unreachable"
      ]
    }
  },
  "spec": "roles/specs/technical-writing.spec.json"
}
