{
  "marketplace": "tokenmaxxxer-architecture",
  "repo": "tokenmaxxxer/architecture-rulebook",
  "path": "$TOKENMAXXXER_RULEBOOKS/architecture-rulebook",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "github.com"
      ]
    }
  },
  "decides": "컴포넌트 경계·의존 방향",
  "use_when": "새 모듈 경계나 기존 경계 변경이 걸릴 때",
  "produces": "ADR (context/decision/consequences), boundary diagram",
  "write_scope": [
    "docs/decisions/*.md",
    "docs/issue-<n>/reports/architecture.md"
  ],
  "record_fields": {
    "loop_state": {
      "progress": [
        "drafting",
        "reviewing"
      ],
      "terminal": [
        "landed"
      ],
      "refusal": [
        "decision-not-ripe"
      ],
      "error": [
        "options-unreachable"
      ]
    }
  },
  "spec": "roles/specs/architecture.spec.json"
}
