{
  "decides": "어떤 메시지로 어떤 채널에 도달할지",
  "produces": "messaging doc, channel plan, target segment",
  "record_fields": {
    "loop_state": {
      "error": [
        "market-unreachable"
      ],
      "progress": [
        "researching",
        "positioning"
      ],
      "refusal": [
        "alternatives-undeclared"
      ],
      "terminal": [
        "landed"
      ]
    }
  },
  "record_spec": {
    "loop_state": {
      "error": [
        "market-unreachable"
      ],
      "progress": [
        "researching",
        "positioning"
      ],
      "refusal": [
        "alternatives-undeclared"
      ],
      "terminal": [
        "landed"
      ]
    },
    "recomputation": {
      "checked_by": "TBD (follow-up — issue-521 out-of-scope note: per-role recomputation enforcement is a follow-up once evidence from real usage shows which roles need it)",
      "rule": "value_themes is recomputed from unique_attributes and competitive_alternatives at each positioning review, never a standalone asserted field."
    },
    "reference_resolution": {
      "checked_by": "on-the-record/hooks/role-spec-reference-guard.sh",
      "rule": "market_category, when it names a competitor, must resolve to an actual tracked competitor entry — no orphan references (issue-515 invariant 2)."
    },
    "required_fields": [
      {
        "name": "competitive_alternatives",
        "required": true,
        "type": "string"
      },
      {
        "name": "unique_attributes",
        "required": true,
        "type": "string"
      },
      {
        "name": "value_themes",
        "required": true,
        "type": "string"
      },
      {
        "name": "target_market",
        "required": true,
        "type": "string"
      },
      {
        "name": "market_category",
        "required": true,
        "type": "ref"
      }
    ],
    "source_standard": "April Dunford's positioning framework, https://www.aprildunford.com/books",
    "use_when": {
      "board_condition": "a new product or segment launches AND no marketing record exists yet for that positioning"
    },
    "write_scope": [
      "docs/issue-<n>/reports/marketing.md"
    ]
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "github.com"
      ]
    }
  },
  "spec": "roles/specs/marketing.spec.json",
  "use_when": "캠페인/포지셔닝이 걸릴 때"
}
